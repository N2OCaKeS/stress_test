# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG ALLTA_API_CA_B64

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      ca-certificates \
      curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /auth

RUN pip install --upgrade pip
RUN pip install "poetry>=2.2.1"

COPY . .

RUN poetry version && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi
RUN test -n "$ALLTA_API_CA_B64" && \
    printf '%s' "$ALLTA_API_CA_B64" | base64 -d > /usr/local/share/ca-certificates/allta-api.crt && \
    update-ca-certificates
RUN python - <<'PY'
import pathlib
import sys

cert = pathlib.Path("/usr/local/share/ca-certificates/allta-api.crt").read_bytes()
try:
    import certifi
except Exception:
    sys.exit(0)

bundle = pathlib.Path(certifi.where())
data = bundle.read_bytes()
if cert not in data:
    with bundle.open("ab") as fh:
        if not data.endswith(b"\n"):
            fh.write(b"\n")
        fh.write(cert)
        if not cert.endswith(b"\n"):
            fh.write(b"\n")
PY

EXPOSE 8000

CMD ["gunicorn", "--config", "gunicorn_conf.py", "app.main:app"]
