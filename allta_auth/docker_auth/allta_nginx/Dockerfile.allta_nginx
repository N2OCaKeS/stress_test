
# syntax=docker/dockerfile:1.7
FROM nginx:alpine

ARG ALLTA_API_CA_B64

RUN apk add --no-cache apache2-utils ca-certificates

# Update the base image to ensure all packages are up-to-date
RUN apk update && apk upgrade --no-cache


RUN rm /etc/nginx/conf.d/default.conf
RUN mkdir -p /etc/nginx/services

COPY template/nginx.conf /etc/nginx/nginx.conf
COPY template/conf.d/* /etc/nginx/conf.d/
COPY template/services/* /etc/nginx/services/
COPY template/html /etc/nginx/html
RUN test -n "$ALLTA_API_CA_B64" && \
    printf '%s' "$ALLTA_API_CA_B64" | base64 -d > /usr/local/share/ca-certificates/allta-api.crt && \
    update-ca-certificates

# Expose HTTPS port
EXPOSE 443

# Launch Nginx in the foreground
CMD ["nginx", "-g", "daemon off;"]
