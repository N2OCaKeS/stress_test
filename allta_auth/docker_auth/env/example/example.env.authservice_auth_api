ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=10
COOKIE_SECURE=false
SQL_ECHO=false

DATABASE_URL=postgresql://<ИМЯ ПОЛЬЗОВАТЕЛЯ>:<ПАРОЛЬ>@authservice-auth-db:5432/allta_auth

BASE_ADMIN_USERNAME=<ИМЯ ПОЛЬЗОВАТЕЛЯ>
BASE_ADMIN_PASSWORD=<ПАРОЛЬ>
SEED_DEFAULT_ADMIN=true

# Docker Registry integration
REGISTRY_ALLOW_ANON_PULL=true
REGISTRY_PUSH_REQUIRES_ADMIN=true
REGISTRY_TOKEN_EXPIRE_SECONDS=600
REGISTRY_TOKEN_ISSUER=allta-auth
REGISTRY_TOKEN_SERVICE=allta.devos.astralinux.ru:21503
REGISTRY_TOKEN_ALGORITHM=RS256
REGISTRY_TOKEN_PRIVATE_KEY_PATH=/run/secrets/registry/registry_signing.key
REGISTRY_TOKEN_CERT_PATH=/run/secrets/registry/auth-registry.crt

# DevPI integration
DEVPI_WRITE_REQUIRES_ADMIN=true

# Generic OAuth integration
OAUTH_CODE_EXPIRE_SECONDS=120
OAUTH_TOKEN_EXPIRE_SECONDS=300
OAUTH_ISSUER=allta-auth
OAUTH_DEFAULT_SCOPE=profile

# Bootstrap OAuth clients in DB (created only if absent)
OAUTH_BOOTSTRAP_CLIENTS_ENABLED=true
# Secrets are generated automatically by auth-init:
# /run/secrets/registry/oauth_clients/*.secret
# /run/secrets/registry/oauth_clients/clients.env
