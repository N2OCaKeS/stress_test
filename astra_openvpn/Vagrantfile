Vagrant.configure("2") do |config|
  config.vm.box = ENV['UPDATE']
  config.vm.box_url = ENV['BOX_URL']
  config.vm.synced_folder "./", "/vagrant", disabled: false
  config.vm.boot_timeout = 180
  num_vms = ENV['COUNT'].to_i
  vms = []

  (1..num_vms).each do |i|
    vms << {
      name: "testvm#{i}",
      hostname: "testvm#{i}.stress.rbt",
      args: "testvm#{i}",
      cpus: ENV['CPU'],
      memory: ENV['RAM']
    }
  end

  vms.each do |machine|
    config.vm.define machine[:name] do |node|
      node.vm.hostname = machine[:hostname]

  node.vm.provider :libvirt do |v|
    v.memory = machine[:memory]
    v.cpus = machine[:cpus]
    v.default_prefix = ""
    v.disk_bus = "sata"  
  end
  
  node.vm.provision "shell", path: "provision/env_provision.sh", args: [ENV['RC'], ENV['KERNEL']]
  node.vm.provision "shell", inline: "echo 'Rebooting VM...'; sudo reboot", run: "always"
  end
  end
end


