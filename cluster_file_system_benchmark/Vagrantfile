Vagrant.configure("2") do |config|
    config.vm.box = ENV['UPDATE']
    config.vm.box_url = ENV['BOX_URL']
    config.vm.synced_folder "./", "/vagrant", disabled: true
    config.vm.boot_timeout = 180
    # config.nfs.verify_installed = false
    num_vms = ENV['COUNT'].to_i
    vms = []

    for i in 1..num_vms do
      new_vm = { 
        :name => "testvm#{i}", 
        :hostname => "testvm#{i}.stress.rbt", 
        :args => "testvm#{i}", 
        :cpus => "4", 
        :memory => "8192"
        
      }
      vms.push(new_vm)
    end
      
    vms.each do |machine|
      
      config.vm.define machine[:name] do |node|
        node.vm.hostname = machine[:hostname]
        # node.vm.synced_folder "./", "/git", type: "nfs"
        node.vm.provider :libvirt do |v|
          v.memory = machine[:memory]
          v.cpus = machine[:cpus]
          v.default_prefix = ""
          v.disk_bus = "sata"
          # v.storage :file, :size => '10G'
        end
        node.vm.provision "shell", path:"provision.sh", args: [ENV['HOSTIP'] ,ENV['RC'], ENV['KERNEL']]
      #  node.vm.provision "shell", inline: "echo 'Rebooting VM...'; sudo reboot", run: "always"
       
      end
    end
  end