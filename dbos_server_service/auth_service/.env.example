# ── Application ───────────────────────────────────────────────────────────────

# Internal service name (used in logs and OpenAPI title)
APP_NAME=auth_service

# Runtime environment: local | development | test | production
APP_ENV=local

# Interface the uvicorn server binds to (0.0.0.0 = all interfaces)
APP_HOST=0.0.0.0

APP_PORT=8000

# Enable FastAPI debug mode and detailed tracebacks — set false in production
APP_DEBUG=true

# Python logging level: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (psycopg3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=postgresql+psycopg://auth_user:auth_password@localhost:5432/auth_db
# Kubernetes / staging example:
# DATABASE_URL=postgresql+psycopg://auth_user:StrongPass@auth-postgres.auth-service.svc.cluster.local:5432/auth_db

# ── Security ──────────────────────────────────────────────────────────────────

# Secret key for signing JWT access tokens — MUST be changed in production.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Access token lifetime in minutes (short-lived by design)
ACCESS_TOKEN_TTL_MINUTES=10

# Refresh token lifetime in days (rotated on every use)
REFRESH_TOKEN_TTL_DAYS=14

# ── Docker registry token auth ────────────────────────────────────────────────

# Hostname of your Docker registry (must match registry config.yml → auth.token.service)
DOCKER_REGISTRY_SERVICE=registry.example.com

# Issuer claim in Docker JWT tokens (must match registry config.yml → auth.token.issuer)
DOCKER_REGISTRY_ISSUER=auth_service

# Docker token lifetime in minutes (short-lived; Docker refreshes automatically)
DOCKER_TOKEN_TTL_MINUTES=5

# RSA private key (PEM) for signing Docker JWT tokens with RS256.
# If omitted: an ephemeral key is generated on startup (dev only — restarting invalidates tokens).
# Generate:
#   openssl genrsa -out docker_signing_key.pem 2048
#   # Then paste the contents below, replacing newlines with \n:
# DOCKER_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
#
# Registry configuration (config.yml):
#   auth:
#     token:
#       realm:          https://<auth-service-host>/api/auth/v1/docker/token
#       service:        registry.example.com        # must match DOCKER_REGISTRY_SERVICE
#       issuer:         auth_service                # must match DOCKER_REGISTRY_ISSUER
#       rootcertbundle: /certs/docker_signing_key.pub
#
# Get the public key:
#   curl https://<auth-service-host>/api/auth/v1/docker/certs > docker_signing_key.pub

# ── Bootstrap ─────────────────────────────────────────────────────────────────

# One-time bootstrap: if these are set AND the users table is empty on startup,
# an account_admin is created automatically. Ignored once any user exists.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-immediately
# INITIAL_ADMIN_EMAIL=admin@example.com
