<mxfile host="app.diagrams.net">
  <diagram id="dtqc-emm-interactions" name="DTQC-EMM — взаимодействие">
    <mxGraphModel dx="900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="DTQC-EMM (EMM) — схема взаимодействия" style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="125" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Оператор (центр 425) -->
        <mxCell id="op" value="Оператор" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="395" y="60" width="60" height="70" as="geometry" />
        </mxCell>

        <!-- Слой 0: пользовательские приложения (центр 425) -->
        <mxCell id="apps_tier" value="Пользовательские приложения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b0b0b0;verticalAlign=top;align=center;spacingTop=6;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="170" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="web" value="web_settings&#10;React SPA + Nginx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="265" y="205" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="cli&#10;консольное приложение (Go)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="445" y="205" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Слой 1: auth (центр) + loging (справа) -->
        <mxCell id="auth" value="auth_service&#10;JWT / PAT / bot, OAuth2+PKCE, introspect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="305" y="350" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="loging" value="loging_service&#10;централизованный аудит, retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="350" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Слой 2: прикладные сервисы (центр 425) -->
        <mxCell id="svc_tier" value="Прикладные сервисы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b0b0b0;verticalAlign=top;align=center;spacingTop=6;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="125" y="490" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="server" value="server_service&#10;серверы, IPMI, пароли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="150" y="525" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vm" value="vm_service&#10;ВМ: диски, снимки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="345" y="525" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="secret" value="secret_service&#10;токены/креды интеграций" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="530" y="525" width="170" height="70" as="geometry" />
        </mxCell>

        <!-- Слой 3: воркеры (центр 425) -->
        <mxCell id="wrk_tier" value="Фоновые воркеры (taskiq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b0b0b0;verticalAlign=top;align=center;spacingTop=6;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="700" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sworker" value="server_worker&#10;Redfish / IPMI / SSH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="265" y="735" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vworker" value="vm_worker&#10;SSH → virsh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="445" y="735" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Слой 4: внешние цели (центр 425) -->
        <mxCell id="ext_tier" value="Внешние цели — за пределами сети платформы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;align=center;spacingTop=6;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="890" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="servers" value="Управляемые серверы&#10;Redfish / IPMI / SSH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="265" y="925" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hyper" value="Хост(ы) с ВМ&#10;libvirt / QEMU-KVM (по SSH)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="445" y="925" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Хранилище справа: pg по центру слоя сервисов (Y=550), redis по центру слоя воркеров (Y=760) -->
        <mxCell id="pg" value="PostgreSQL&#10;(своя БД на сервис)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="510" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="Redis&#10;брокер задач" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="720" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- ===== Рёбра ===== -->
        <!-- центральная ось вниз -->
        <mxCell id="e_op_apps" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="op" target="apps_tier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_apps_auth" value="login → JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apps_tier" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_auth_svc" value="introspect / проверка прав" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#999999;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="auth" target="svc_tier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_svc_wrk" value="dispatch задач" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc_tier" target="wrk_tier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_wrk_ext" value="Redfish / IPMI / SSH; SSH → virsh — за пределы сети" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="wrk_tier" target="ext_tier"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- apps → сервисы (API), по левому полю -->
        <mxCell id="e_apps_svc" value="API (по правам)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="apps_tier" target="svc_tier">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="95" y="225" />
              <mxPoint x="95" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- горизонтальные строго прямые -->
        <mxCell id="e_auth_log" value="аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="auth" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_svc_log" value="аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="secret" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_svc_pg" value="данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="svc_tier" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_wrk_redis" value="broker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wrk_tier" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Легенда -->
        <mxCell id="leg" value="Зелёные — реализовано; жёлтые — планируется. Серый пунктир — introspect / API; синий пунктир — БД; красное — выход за пределы сети платформы." style="text;html=1;align=left;fontSize=11;fontStyle=2;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="870" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
