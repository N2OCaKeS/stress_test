<mxfile host="app.diagrams.net">
  <diagram id="dbos-interactions" name="DBOS — взаимодействие">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="DBOS Server Manager — схема взаимодействия (всё ПО на одном хосте/в одной сети)" style="text;html=1;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="780" height="30" as="geometry" />
        </mxCell>

        <mxCell id="host" value="Хост (ВМ) — единая сеть платформы" style="rounded=0;dashed=1;dashPattern=6 6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;fontStyle=1;fillColor=none;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="780" height="520" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="auth_service&#10;(JWT/PAT/bot, OAuth2+PKCE, introspect)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="loging" value="loging_service&#10;(аудит, правила, retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="610" y="130" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="server" value="server_service&#10;(серверы, IPMI, пароли)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vm" value="vm_service&#10;(ВМ: диски, снимки)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="250" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="secret" value="secret_service&#10;(токены/креды интеграций)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="250" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sworker" value="server_worker&#10;(taskiq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="vworker" value="vm_worker&#10;(taskiq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="260" y="380" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="Redis" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="470" y="380" width="80" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="PostgreSQL&#10;(своя БД на сервис)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="web" value="web_settings&#10;(React SPA, Nginx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="610" y="500" width="170" height="50" as="geometry" />
        </mxCell>

        <mxCell id="operator" value="Оператор&#10;(cli — Astra; web-браузер)" style="shape=umlActor;verticalLabelPosition=bottom;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="60" height="90" as="geometry" />
        </mxCell>
        <mxCell id="servers" value="Управляемые серверы&#10;(Redfish / IPMI / SSH)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="370" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hyper" value="Хост(ы) с ВМ&#10;(libvirt/QEMU-KVM, VirtualBox)&#10;управление по SSH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="login → JWT" style="endArrow=block;html=1;" edge="1" parent="1" source="operator" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="API (web/cli)" style="endArrow=block;html=1;" edge="1" parent="1" source="operator" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="operator" target="vm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3" value="introspect (per-request, без кэша)" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="server" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3b" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="vm" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3c" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="secret" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e4" value="аудит" style="endArrow=block;html=1;" edge="1" parent="1" source="server" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4b" style="endArrow=block;html=1;" edge="1" parent="1" source="vm" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4c" style="endArrow=block;html=1;" edge="1" parent="1" source="secret" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4d" style="endArrow=block;html=1;" edge="1" parent="1" source="auth" target="loging"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e5" value="dispatch" style="endArrow=block;html=1;" edge="1" parent="1" source="server" target="sworker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5b" value="dispatch" style="endArrow=block;html=1;" edge="1" parent="1" source="vm" target="vworker"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" value="broker" style="endArrow=block;html=1;" edge="1" parent="1" source="sworker" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6b" value="broker" style="endArrow=block;html=1;" edge="1" parent="1" source="vworker" target="redis"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e7" value="Redfish/IPMI/SSH (за пределы сети)" style="endArrow=block;html=1;strokeColor=#b85450;" edge="1" parent="1" source="sworker" target="servers"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="SSH → virsh/VBoxManage (за пределы сети)" style="endArrow=block;html=1;strokeColor=#b85450;" edge="1" parent="1" source="vworker" target="hyper"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e9" value="данные" style="endArrow=block;html=1;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="server" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="leg" value="Зелёные — реализовано; жёлтые — планируется. Сплошные стрелки — внутри сети; красные — выход за пределы сети." style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="900" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
