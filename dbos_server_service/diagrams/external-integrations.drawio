                <mxCell id="git" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;• клонирование репозитория&lt;br&gt;(тесты / сценарии прогонов)&lt;br&gt;HTTPS · git smart-protocol · Bearer-токен" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
