                <mxCell id="bamboo" value="&lt;b&gt;testo-bamboo&lt;/b&gt;&lt;br&gt;Назначение: уточняется (предположительно CI / Bamboo)&lt;br&gt;Протокол / авторизация: уточняется&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
