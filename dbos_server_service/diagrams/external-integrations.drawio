                <mxCell id="hdr" value="Корпоративные сервисы" style="text;html=1;align=center;fontSize=12;fontStyle=2;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="20" y="296" width="900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="jira" value="&lt;b&gt;Jira&lt;/b&gt;&lt;br&gt;Направление: EMM пишет и читает&lt;br&gt;• доступ к проекту BT&lt;br&gt;• доступ к проекту DEVQA&lt;br&gt;• доступ к Zephyr&lt;br&gt;Протокол: HTTPS · REST&lt;br&gt;Авторизация: токен на проект и операцию (r/w)&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="330" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="zephyr" value="&lt;b&gt;Zephyr&lt;/b&gt;&lt;br&gt;Направление: EMM пишет (+ читает статусы)&lt;br&gt;• создание тест-прогонов&lt;br&gt;• обновление статусов (pass/fail/blocked)&lt;br&gt;• проекты BT, DEVQA, … — отдельные токены,&lt;br&gt;&#160;&#160;разные уровни доступа по проектам&lt;br&gt;Протокол: HTTPS · REST · токен ≠ Jira&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="520" y="330" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="conf" value="&lt;b&gt;Confluence&lt;/b&gt;&lt;br&gt;Направление: EMM пишет&lt;br&gt;• публикация новых отчётов (create page)&lt;br&gt;• обновление существующих (update page)&lt;br&gt;Протокол: HTTPS · REST (JSON)&lt;br&gt;Авторизация: API-token&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="tag" value="&lt;b&gt;TAG&lt;/b&gt;&lt;br&gt;Направление: EMM пишет (отправляет)&lt;br&gt;• сообщения от имени бота&lt;br&gt;&#160;&#160;(уведомления о прогонах/отчётах)&lt;br&gt;Протокол: HTTPS · REST&lt;br&gt;Авторизация: bot-token(ы)&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="520" y="540" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="git" value="&lt;b&gt;Git&lt;/b&gt; — https://10.177.5.111/git&lt;br&gt;Направление: EMM читает (клонирование)&lt;br&gt;• клонирование репозитория (тесты/сценарии)&lt;br&gt;Протокол: HTTPS · git smart-protocol&lt;br&gt;Доступ: НАПРЯМУЮ, без API-шлюза&lt;br&gt;Токен не хранится" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="750" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="rel" value="&lt;b&gt;releases.devos.astralinux.ru&lt;/b&gt;&lt;br&gt;Направление: EMM читает&lt;br&gt;• список версий ОС&lt;br&gt;• URL для скачивания пакетов&lt;br&gt;Протокол: HTTPS · GET&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="520" y="750" width="380" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="wiki" value="&lt;b&gt;Wiki&lt;/b&gt; (вероятно legacy)&lt;br&gt;Назначение: уточняется&lt;br&gt;Протокол / авторизация: уточняется&lt;br&gt;Доступ: через API-шлюз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
