                </mxCell>
                <mxCell id="zephyr" value="&lt;b&gt;Zephyr&lt;/b&gt;&lt;br&gt;• создание тест-прогонов&lt;br&gt;• обновление статусов (pass/fail/blocked)&lt;br&gt;• проекты: BT, DEVQA, … (отдельные токены,&lt;br&gt;&#160;&#160;разные уровни доступа по проектам)&lt;br&gt;HTTPS · REST · токен ≠ Jira" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="520" y="330" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="conf" value="&lt;b&gt;Confluence&lt;/b&gt;&lt;br&gt;• публикация новых отчётов (create page)&lt;br&gt;• обновление существующих (update page)&lt;br&gt;HTTPS · REST (JSON) · API-token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="510" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="tag" value="&lt;b&gt;TAG&lt;/b&gt;&lt;br&gt;• сообщения от имени бота&lt;br&gt;(уведомления о прогонах/отчётах)&lt;br&gt;HTTPS · REST · bot-token(ы)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="520" y="510" width="380" height="150" as="geometry"/>
