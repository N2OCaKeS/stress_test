                <mxCell id="cal" value="&lt;b&gt;calendar&lt;/b&gt; (плагин life)&lt;br&gt;• назначение уточняется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" parent="1" vertex="1">
