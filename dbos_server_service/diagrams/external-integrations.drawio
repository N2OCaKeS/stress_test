                <mxCell id="gw" value="&lt;b&gt;API-шлюз&lt;/b&gt; (требуется)&lt;br&gt;единая точка доступа к корпоративным сервисам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=12;" parent="1" vertex="1">
