# ШАБЛОН. НЕ применять напрямую — реальные значения генерирует scripts/k8s/gen_secrets.sh.
# После генерации файл `20-secrets.yaml` появится рядом и попадёт в .gitignore.

apiVersion: v1
kind: Secret
metadata:
  name: dbos-secrets
  namespace: dbos
type: Opaque
stringData:
  # ── Postgres ────────────────────────────────────────────────────────────────
  AUTH_DB_USER: auth_user
  AUTH_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  LOGGING_DB_USER: logging_user
  LOGGING_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

  # ── auth_service ────────────────────────────────────────────────────────────
  # Подпись JWT — 32+ символов, рандом
  AUTH_SECRET_KEY: CHANGE_ME_RANDOM_AT_LEAST_32_CHARS_LONG

  # RSA private key для подписи Docker registry-токенов.
  # Сгенерировать:  openssl genrsa 2048 | base64 -w0
  # Здесь — PEM-текст как есть (multiline через | в YAML).
  DOCKER_RSA_PRIVATE_KEY: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE_WITH_REAL_KEY
    -----END RSA PRIVATE KEY-----

  # Начальный admin (создаётся один раз при первом старте на пустой БД)
  INITIAL_ADMIN_USERNAME: admin
  INITIAL_ADMIN_PASSWORD: CHANGE_ME_RANDOM
  INITIAL_ADMIN_EMAIL: admin@example.com

  # ── loging_service ──────────────────────────────────────────────────────────
  # Shared secret для сервис-к-сервис вызовов из auth_service в logging
  LOGGING_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── server_service ──────────────────────────────────────────────────────────
  # Отдельная БД server_service (модель серверов, IPMI controllers,
  # зашифрованные креды server accounts).
  SERVER_DB_USER: server_user
  SERVER_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

  # Мастер-ключ для AES-256-GCM шифрования паролей. Сгенерировать:
  # `openssl rand -base64 32`. min_length=32 в Settings.
  SERVER_ENCRYPTION_KEY: CHANGE_ME_BASE64_RANDOM_32_BYTES_OR_LONGER
  # Активная версия ключа (пишется в новые ciphertext'ы как `v<N>$...`).
  # 1 = legacy SHA-256, 2+ = HKDF-SHA256 (рекомендовано).
  SERVER_ENCRYPTION_KEY_VERSION: "2"

  # Outbound bearer от server_service → auth_service (introspect / service-access).
  SERVER_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Inbound SERVICE_API_KEYS-map для server_service /internal/* (per-service
  # bearer'ы, главный — worker_bot). Формат: `worker_bot:<token>` либо
  # JSON `{"worker_bot": "<token>"}` — см. README сервиса.
  SERVER_INBOUND_SERVICE_API_KEYS: 'worker_bot:CHANGE_ME_RANDOM_32_CHARS'

  # ── server_worker + Redis broker ────────────────────────────────────────────
  # Собственная БД worker'а (tasks, audit outbox, heartbeats).
  WORKER_DB_USER: worker_user
  WORKER_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

  # Redis (taskiq broker, общий между server_service-publisher и
  # server_worker-consumer). AUTH обязателен в проде — иначе любой pod
  # в той же сети RPUSH'ит в очередь и инициирует power-cycle.
  REDIS_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

  # PAT (bot-token), которым worker аутентифицируется в /internal/*
  # server_service. Issued через auth_service /bots, scope ограничен
  # сервисом 'server_service' с ролью worker_bot.
  WORKER_BOT_TOKEN: CHANGE_ME_dbos_bot_TOKEN

  # Outbound bearer от worker → auth_service /authorization/introspect
  # (для собственного bot-токена). Совпадает с SERVICE_API_KEYS[server_worker]
  # на стороне auth_service.
  WORKER_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
