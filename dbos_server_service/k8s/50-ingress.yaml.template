# ШАБЛОН. Реальный 50-ingress.yaml генерирует scripts/k8s/gen_secrets.sh
# (подставляет __INGRESS_HOST__ → ваш домен).

apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dbos-ingress
  namespace: dbos
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    # Edge-TLS-cert лежит готовым в Secret `dbos-ingress-tls`, его кладёт
    # scripts/k8s/gen_secrets.sh (self-signed, SAN под DNS/IP). cert-manager
    # сюда не подключаем: для IP-режима он leaf под host=IP не выпустит, а
    # для DNS-режима overhead с двойным источником ничего не даёт.
    # Cluster-internal вызовы между сервисами идут по plain http
    # (NetworkPolicy default-deny закрывает namespace).
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - __INGRESS_HOST__
      secretName: dbos-ingress-tls
  rules:
    - host: __INGRESS_HOST__
      http:
        paths:
          - path: /api/auth
            pathType: Prefix
            backend:
              service:
                name: auth-service
                port:
                  number: 8000
          - path: /api/logging
            pathType: Prefix
            backend:
              service:
                name: logging-service
                port:
                  number: 8001
          - path: /api/server
            pathType: Prefix
            backend:
              service:
                name: server-service
                port:
                  number: 8002
          - path: /api/secret
            pathType: Prefix
            backend:
              service:
                name: secret-service
                port:
                  number: 8003
          - path: /docs
            pathType: Prefix
            backend:
              service:
                name: dbos-swagger-ui
                port:
                  number: 8080

---
# Отдельный Ingress на HTTP (80) — редиректит на HTTPS
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: dbos-ingress-redirect
  namespace: dbos
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web
    # Middleware для редиректа HTTP → HTTPS
    traefik.ingress.kubernetes.io/router.middlewares: dbos-https-redirect@kubernetescrd
spec:
  ingressClassName: traefik
  rules:
    - host: __INGRESS_HOST__
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: auth-service
                port:
                  number: 8000

---
# Middleware для редиректа HTTP→HTTPS (Traefik CRD)
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: https-redirect
  namespace: dbos
spec:
  redirectScheme:
    scheme: https
    permanent: true
