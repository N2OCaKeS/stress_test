APP_NAME=logging_service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://logging_user:logging_password@localhost:5432/logging_db

# Shared secret that all services must include in Authorization: Bearer <key>
SERVICE_API_KEY=change-me-use-a-long-random-string

# Human admin credentials for /docs login (POST /token)
# Swagger UI: click Authorize → enter username + password
LOGGING_ADMIN_USERNAME=admin
LOGGING_ADMIN_PASSWORD=change-me-immediately
