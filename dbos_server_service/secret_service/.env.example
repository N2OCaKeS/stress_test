# ── Application ───────────────────────────────────────────────────────────────

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8003

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+psycopg://secret_user:secret_password@localhost:5432/secret_db

# ── Auth service (introspect для входящих токенов) ───────────────────────────

AUTH_SERVICE_URL=http://localhost:8000
INTROSPECT_SERVICE_API_KEY=change-me-introspect-key
INTROSPECT_TLS_VERIFY=true
INTROSPECT_TLS_CA_BUNDLE=

# ── Logging service (опциональный удалённый аудит) ───────────────────────────

LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_KEY=

# ── Encryption ────────────────────────────────────────────────────────────────

# Мастер-ключ для AES-256-GCM шифрования секретов. Min 32 chars.
# Generate: openssl rand -base64 48
SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-master-key-32-chars-min
SECRET_ENCRYPTION_KEY_VERSION=2

# HKDF salt в hex (минимум 32 hex = 16 байт). В staging/production обязателен.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HKDF_SALT_HEX=

# ── Inbound service-to-service auth ──────────────────────────────────────────

# Legacy fallback (deprecated, оставлен для миграции). Per-service map ниже —
# предпочтительный путь.
SERVICE_API_KEY=

# Per-service inbound map: каждый известный caller получает свой ключ.
# Формат: JSON-объект {"<service_name>": "<api_key>", ...} или
# comma-separated "<svc>:<key>,<svc>:<key>".
SERVICE_API_KEYS=

# ── Rate-limit ────────────────────────────────────────────────────────────────

SLOWAPI_RATE_LIMIT=120/second
RATE_LIMIT_STORAGE_URI=memory://

# Пароль Redis (если он используется в RATE_LIMIT_STORAGE_URI или для других нужд).
REDIS_PASSWORD=
