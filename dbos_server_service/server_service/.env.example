# ── Application ───────────────────────────────────────────────────────────────

APP_ENV=local

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/server_db

# ── Auth service ──────────────────────────────────────────────────────────────

AUTH_SERVICE_URL=http://localhost:8000

# Shared service-to-service secret. MUST match SERVICE_API_KEY у auth_service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_KEY=change-me-service-key

# ── Encryption ────────────────────────────────────────────────────────────────

# Master key for symmetric encryption of stored passwords (server accounts,
# IPMI credentials). Min length 32 chars. MUST be changed in production.
# Generate: openssl rand -base64 48
SERVER_ENCRYPTION_KEY=change-me-to-a-long-random-master-key-32-chars-min

# Active key version. v1 = legacy single-pass SHA-256 (legacy back-compat only),
# v2+ = HKDF-SHA256. New deployments must default to 2.
SERVER_ENCRYPTION_KEY_VERSION=2

# HKDF salt (hex). Min 32 hex chars (16 bytes). REQUIRED in staging/production —
# Settings will refuse to start with empty value. In local/dev/test пустое
# значение допустимо (подставляется fallback из кода).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
HKDF_SALT_HEX=

# ── Worker dispatch (optional) ────────────────────────────────────────────────

SERVER_WORKER_DATABASE_URL=
SERVER_WORKER_REDIS_URL=

# ── Logging service (optional remote audit) ───────────────────────────────────

LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_KEY=
