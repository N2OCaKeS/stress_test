# ─────────────────────────────────────────────────────────────────────────────
#  DO NOT COMMIT real values from this file.
#
#  Это ШАБЛОН. Реальный `20-secrets.yaml` генерирует
#  `scripts/k8s/gen_secrets.sh <domain>` (gitignored).
#  Все CHANGE_ME_* плейсхолдеры — нерабочие пометки.
#
#  Если правишь руками — после правки:
#    chmod 600 k8s/20-secrets.yaml
#    grep -F "k8s/20-secrets.yaml" .gitignore || echo "файл не игнорится!"
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Secret
metadata:
  name: dbos-secrets
  namespace: dbos
type: Opaque
stringData:
  # ── Postgres (per-service users) ────────────────────────────────────────────
  # У каждого сервиса своя БД и свой пользователь — нет cross-service доступа.
  AUTH_DB_USER: auth_user
  AUTH_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  LOGGING_DB_USER: logging_user
  LOGGING_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  SERVER_DB_USER: server_user
  SERVER_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  WORKER_DB_USER: worker_user
  WORKER_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  SECRET_DB_USER: secret_user
  SECRET_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS
  TESTING_DB_USER: testing_user
  TESTING_DB_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

  # ── auth_service ────────────────────────────────────────────────────────────
  # Подпись JWT — 32+ символов, рандом. `openssl rand -base64 48`.
  AUTH_SECRET_KEY: CHANGE_ME_RANDOM_AT_LEAST_32_CHARS_LONG

  # RSA private key для подписи Docker registry-токенов.
  # Сгенерировать:  openssl genrsa 2048
  # Кладётся PEM-текст как есть (multiline через | в YAML).
  DOCKER_RSA_PRIVATE_KEY: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE_WITH_REAL_KEY
    -----END RSA PRIVATE KEY-----

  # Начальный admin (создаётся один раз при первом старте на пустой БД).
  INITIAL_ADMIN_USERNAME: admin
  INITIAL_ADMIN_PASSWORD: CHANGE_ME_RANDOM
  INITIAL_ADMIN_EMAIL: admin@example.com

  # ── loging_service ──────────────────────────────────────────────────────────
  # Outbound bearer от каждого внутреннего caller'а к loging_service.
  # Используется auth_service / server_service / server_worker. Значение
  # должно совпадать с соответствующей записью в LOGGING_SERVICE_API_KEYS_JSON.
  LOGGING_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # Inbound per-service ingest keys для loging_service (JSON map identity →
  # bearer). Это единственный режим service-to-service auth; legacy
  # SERVICE_API_KEY удалён. Значения должны попарно совпадать с outbound
  # LOGGING_SERVICE_API_KEY каждого caller'а. Если ключи разные, проще
  # держать здесь общий — но раздельные снижают blast-radius при leak'е.
  LOGGING_SERVICE_API_KEYS_JSON: |
    {"auth_service":"CHANGE_ME_RANDOM_32_CHARS","server_service":"CHANGE_ME_RANDOM_32_CHARS","config_service":"CHANGE_ME_RANDOM_32_CHARS","server_worker":"CHANGE_ME_RANDOM_32_CHARS","secret_service":"CHANGE_ME_RANDOM_32_CHARS","testing_service":"CHANGE_ME_RANDOM_32_CHARS"}
  # Outbound bearer от secret_service → loging_service (значение должно совпадать
  # с записью "secret_service" в LOGGING_SERVICE_API_KEYS_JSON).
  LOGGING_SERVICE_API_KEY_SECRET: CHANGE_ME_RANDOM_32_CHARS
  # Outbound bearer от testing_service → loging_service (значение должно
  # совпадать с записью "testing_service" в LOGGING_SERVICE_API_KEYS_JSON).
  LOGGING_SERVICE_API_KEY_TESTING: CHANGE_ME_RANDOM_32_CHARS

  # Outbound bearer loging_service → auth_service /introspect (проверка JWT
  # на reader/admin-эндпоинтах). Обязателен в production; production-guard в
  # Settings отвергает запуск без него и при совпадении со значениями
  # LOGGING_SERVICE_API_KEYS_JSON (key-separation).
  LOGGING_INTROSPECT_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── server_service: encryption (envelope encryption of stored secrets) ──────
  # Мастер-ключ для AES-256-GCM шифрования паролей. `openssl rand -base64 32`.
  # min_length=32 в Settings; KDF — HKDF-SHA256 с HKDF_SALT_HEX.
  SERVER_ENCRYPTION_KEY: CHANGE_ME_BASE64_RANDOM_32_BYTES_OR_LONGER

  # Активная версия мастер-ключа. Пишется в новые ciphertext'ы как `v<N>$...`.
  # 1 = legacy SHA-256 (только для расшифровки исторических строк),
  # 2+ = HKDF-SHA256 (рекомендовано). В prod/staging минимум 2.
  SERVER_ENCRYPTION_KEY_VERSION: "2"

  # HKDF salt (hex, минимум 32 hex-символа = 16 байт). Settings отбивает
  # пустое значение в production/staging. `openssl rand -hex 16`.
  # ВАЖНО: salt участвует в KDF — при смене salt'а потребуется re-encrypt всех
  # столбцов, как при ротации мастер-ключа. Не менять без runbook'а.
  HKDF_SALT_HEX: CHANGE_ME_32_HEX_CHARS

  # ─── Previous master key (rotation window) ─────────────────────────────────
  # На время rotation flow (см. scripts/k8s/rotate_master_key.sh) сюда
  # кладётся ПРЕДЫДУЩИЙ мастер-ключ под именем `SERVER_ENCRYPTION_KEY__v<N-1>`.
  # server_service использует его для on-the-fly decrypt старых ciphertext'ов
  # (`v<N-1>$...`), пока background reencrypt-задача в server_worker
  # (`secrets.reencrypt_lazy`) не перешьёт все строки на новую версию.
  # После того как `/migration_status` отдаст `remaining=0` и outbox пуст —
  # ключ можно удалить из Secret'а (см. runbook в obsidian/infra/Secrets management.md).
  # Закомментировано по умолчанию; включается только в окно ротации.
  # SERVER_ENCRYPTION_KEY__v1: CHANGE_ME_PREVIOUS_BASE64_RANDOM_32_BYTES

  # ── server_service: service-to-service auth ─────────────────────────────────
  # Outbound bearer от server_service → auth_service (introspect / service-access).
  SERVER_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Inbound SERVICE_API_KEYS-map для server_service /internal/* (per-service
  # bearer'ы, главный — worker_bot). Формат: `worker_bot:<token>` либо
  # JSON `{"worker_bot": "<token>"}` — см. README сервиса.
  # В ssh-режиме console_proxy тянет mgmt-креды хаба через тот же /internal —
  # добавьте запись `console_proxy:<token>` и совпадающий CONSOLE_PROXY_SERVER_API_KEY ниже.
  # `testing_service:<token>` — бронь стенда от его имени (acquire-for-service/
  # release-for-service/service-status/prepare-for-test, §5.1/§5.2 плана
  # миграции); попарно совпадает с SERVER_SERVICE_INTERNAL_API_KEY ниже.
  SERVER_INBOUND_SERVICE_API_KEYS: 'worker_bot:CHANGE_ME_RANDOM_32_CHARS,testing_service:CHANGE_ME_RANDOM_32_CHARS'
  # Исходящий callback server_service → testing_service о завершении
  # prepare-for-test (§5.1). Bearer == ключ server_service в inbound-map
  # testing_service (TESTING_INBOUND_SERVICE_API_KEYS ниже).
  TESTING_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Канал брони/подготовки testing_service → server_service (см. запись
  # `testing_service:` в SERVER_INBOUND_SERVICE_API_KEYS выше — должны
  # совпадать байт-в-байт).
  SERVER_SERVICE_INTERNAL_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── console_proxy (веб-консоль ВМ VNC/SPICE) ────────────────────────────────
  # Общий с server_service HMAC-секрет подписи консольного JWT (HS256). Тем же
  # секретом server_service подписывает токен в POST /vms/{id}/console, а прокси
  # его проверяет. Значение ДОЛЖНО совпадать; server_service читает его как
  # VM_CONSOLE_TOKEN_SECRET (добавьте в его env/секрет).
  VM_CONSOLE_TOKEN_SECRET: CHANGE_ME_RANDOM_AT_LEAST_32_CHARS_LONG
  # ws(s)-база console-прокси = wss://<INGRESS_HOST>. gen_secrets.sh наполняет
  # автоматически из домена деплоя; server_service читает как VM_CONSOLE_PROXY_WS_BASE.
  VM_CONSOLE_PROXY_WS_BASE: wss://CHANGE_ME_INGRESS_HOST
  # Ключ, которым console_proxy аутентифицируется в server_service /internal/*
  # (запись console_proxy в SERVER_INBOUND_SERVICE_API_KEYS выше — попарно совпадает).
  # Нужен только в CONSOLE_TARGET_MODE=ssh (fetch mgmt-кред хаба).
  CONSOLE_PROXY_SERVER_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── server_worker ───────────────────────────────────────────────────────────
  # PAT (bot-token), которым worker аутентифицируется в /internal/* server_service.
  # Issued через auth_service /bots; scope ограничен сервисом 'server_service'
  # с ролью worker_bot. Префикс токена — `dbos_bot_…`.
  WORKER_BOT_TOKEN: CHANGE_ME_dbos_bot_TOKEN
  # Outbound bearer от worker → auth_service /authorization/introspect
  # (для собственного bot-токена). Должен попарно совпадать с
  # SERVICE_API_KEYS[server_worker] на стороне auth_service.
  WORKER_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── secret_service ──────────────────────────────────────────────────────────
  # Envelope encryption (AES-256-GCM + HKDF-SHA256). HKDF_SALT_HEX выше — общий.
  SECRET_ENCRYPTION_KEY: CHANGE_ME_BASE64_RANDOM_32_BYTES_OR_LONGER
  SECRET_ENCRYPTION_KEY_VERSION: "2"
  # Outbound bearer secret_service → auth_service /authorization/introspect.
  SECRET_INTROSPECT_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Inbound s2s map для secret_service /internal/* (worker / auth / server).
  SECRET_INBOUND_SERVICE_API_KEYS: 'worker_bot:CHANGE_ME_RANDOM_32_CHARS,auth_service:CHANGE_ME_RANDOM_32_CHARS,server_service:CHANGE_ME_RANDOM_32_CHARS'

  # ── testing_service ──────────────────────────────────────────────────────────
  # Outbound bearer testing_service → auth_service /authorization/introspect.
  TESTING_INTROSPECT_SERVICE_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Inbound s2s map для testing_service /internal/*: `server_service` шлёт
  # callback завершения prepare-for-test (§5.1 плана миграции), `testing_worker`
  # забирает готовые элементы очереди и отчитывается об исходе (§5.5).
  TESTING_INBOUND_SERVICE_API_KEYS: '{"auth_service":"CHANGE_ME_RANDOM_32_CHARS","server_service":"CHANGE_ME_RANDOM_32_CHARS","testing_worker":"CHANGE_ME_RANDOM_32_CHARS"}'
  # Бот testing_service (auth_service заводит его на старте, роль
  # guest@server_service) — нужен choices_source dynamic-резолверам
  # (`dynamic:os_versions`/`kernels`), чтобы читать каталог у server_service.
  # Один и тот же токен монтируется и в auth_service (TESTING_SERVICE_BOT_TOKEN,
  # bootstrap), и в testing_service (SERVER_SERVICE_API_KEY, исходящий bearer).
  TESTING_SERVICE_BOT_TOKEN: CHANGE_ME_dbos_bot_TOKEN
  SERVER_SERVICE_BOT_TOKEN: CHANGE_ME_SEPARATE_dbos_bot_TOKEN
  # Канал брони/подготовки testing_service → server_service (acquire-for-
  # service/release-for-service/service-status/prepare-for-test) — отдельный
  # от бот-токена выше. Должен совпадать байт-в-байт с записью `testing_service:`
  # в SERVER_INBOUND_SERVICE_API_KEYS выше.
  SERVER_SERVICE_INTERNAL_API_KEY: CHANGE_ME_RANDOM_32_CHARS
  # Канал очереди testing_worker → testing_service (/internal/queue/claim,
  # /internal/queue/{id}/completed). Должен совпадать байт-в-байт с записью
  # `testing_worker` в TESTING_INBOUND_SERVICE_API_KEYS выше.
  TESTING_SERVICE_INTERNAL_API_KEY: CHANGE_ME_RANDOM_32_CHARS

  # ── Redis (taskiq broker + rate-limit storage) ──────────────────────────────
  # AUTH обязателен в проде — иначе любой pod в той же сети RPUSH'ит в
  # очередь power-cycle. `_require_redis_auth_in_prod` Settings отбивает.
  REDIS_PASSWORD: CHANGE_ME_RANDOM_32_CHARS

---
# ── Durable keystore: server_service master-ключи ───────────────────────────
# server_service с KEYSTORE_BACKEND=k8s читает master-материал отсюда, а не из
# env SERVER_ENCRYPTION_KEY (тот остаётся только для file-бэкенда / dev). Поля:
#   active_version — версия, под которую шифруются новые ciphertext'ы;
#   key_v<N>       — master-материал версии N (вход HKDF), тот же формат, что
#                    лежал в SERVER_ENCRYPTION_KEY.
# K8sSecretKeyStore читает Secret на первом старте (НЕ bootstrap'ит из env),
# поэтому он должен существовать ДО старта пода. Имена полей и Secret'а должны
# совпадать с _ACTIVE_FIELD / _KEY_FIELD_PREFIX в server_service keystore.py и
# с KEYSTORE_K8S_SECRET в 50-server-service.yaml.
# Миграция с file→k8s на работающем кластере: скопировать сюда текущее
# значение SERVER_ENCRYPTION_KEY в key_v<SERVER_ENCRYPTION_KEY_VERSION> и
# выставить active_version = SERVER_ENCRYPTION_KEY_VERSION ДО переключения
# KEYSTORE_BACKEND, иначе под не прочитает активный ключ и упадёт на старте.
apiVersion: v1
kind: Secret
metadata:
  name: dbos-server-encryption-keys
  namespace: dbos
type: Opaque
stringData:
  active_version: "2"
  key_v2: CHANGE_ME_BASE64_RANDOM_32_BYTES_OR_LONGER

---
# ── Durable keystore: secret_service master-ключи ───────────────────────────
# Отдельный Secret от server_service — крипто двух сервисов раздельно, версии
# ключей не должны смешиваться. Поля и семантика — как выше, но материал из
# SECRET_ENCRYPTION_KEY. Имена должны совпадать с secret_service keystore.py и
# KEYSTORE_K8S_SECRET в 13-secret-service.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: dbos-secret-encryption-keys
  namespace: dbos
type: Opaque
stringData:
  active_version: "2"
  key_v2: CHANGE_ME_BASE64_RANDOM_32_BYTES_OR_LONGER

---
# TLS-сертификат для Traefik Ingress.
# Реальный файл генерирует scripts/k8s/gen_secrets.sh из домена. Здесь — заглушка.
apiVersion: v1
kind: Secret
metadata:
  name: dbos-tls
  namespace: dbos
type: kubernetes.io/tls
data:
  tls.crt: CHANGE_ME_BASE64_PEM
  tls.key: CHANGE_ME_BASE64_PEM
