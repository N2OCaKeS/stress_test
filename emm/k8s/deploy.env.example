# Operator-конфиг предсказуемых кред для DBOS Server Manager.
#
# Копируется в k8s/deploy.env и заполняется ДО `make k8s-zero`. Скрипт
# scripts/k8s/gen_secrets.sh читает этот файл в начале (после k8s/.env.k8s) и
# кладёт заданные значения в k8s/20-secrets.yaml. Всё, что оставлено пустым,
# генерится случайно как раньше — поведение при полностью пустом файле
# идентично тому, что было без deploy.env.
#
#   cp k8s/deploy.env.example k8s/deploy.env
#   $EDITOR k8s/deploy.env      # задать нужное
#   make k8s-zero
#
# deploy.env в .gitignore — реальные значения НЕ коммитятся.
# gen_secrets.sh этот файл только читает и НЕ перезаписывает.

# ── Admin bootstrap ───────────────────────────────────────────────────────────

# Логин initial admin. Пусто → admin.
INITIAL_ADMIN_USERNAME=

# Пароль initial admin. Задай свой, чтобы знать его заранее.
# Пусто → случайный 16-символьный (печатается в конце gen_secrets.sh).
INITIAL_ADMIN_PASSWORD=

# Требовать смену пароля admin при первом входе.
#   true  (дефолт) — admin обязан сменить пароль, smoke-тест форсит смену.
#   false          — admin входит под заданным INITIAL_ADMIN_PASSWORD без
#                    форс-смены; smoke-тест не перетирает пароль.
# Для предсказуемого пароля, который не меняется на первом входе — false.
DBOS_BOOTSTRAP_FORCE_PASSWORD_CHANGE=true

# ── Advanced (обычно оставлять пустыми — генерятся автоматически) ──────────────
# Задавать только при восстановлении деплоя из бэкапа или особых требованиях.
# Формат должен совпадать с генерируемым (см. gen_secrets.sh).

# Bot-токен воркера, формат dbos_bot_<48 URL-safe символов>.
WORKER_BOT_TOKEN=

# Пароли per-service Postgres (по 32 URL-safe символа).
AUTH_DB_PASSWORD=
LOGGING_DB_PASSWORD=
SERVER_DB_PASSWORD=
WORKER_DB_PASSWORD=
SECRET_DB_PASSWORD=

# Master-ключи шифрования (base64 от 32 байт). Менять только осознанно:
# смена ключа после первого деплоя делает существующие ciphertext'ы
# недешифруемыми — используйте rotate_master_key.sh, а не этот файл.
SERVER_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY=
REDIS_STASH_ENCRYPTION_KEY=
CREDS_STASH_ENCRYPTION_KEY=
HKDF_SALT_HEX=
