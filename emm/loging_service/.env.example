APP_NAME=loging_service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=true
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://logging_user:logging_password@localhost:5432/logging_db

# Per-service API keys (JSON map identity → bearer secret). Required: at
# least one entry per internal caller (auth_service / server_service /
# config_service / server_worker / …). Compromise of one key is limited to
# audit forgery from that service's identity only.
SERVICE_API_KEYS={"auth_service":"change-me","server_service":"change-me","config_service":"change-me","server_worker":"change-me"}

# auth_service URL for JWT introspection. REQUIRED in production
# (admin/reader endpoints otherwise return 503). https:// only in prod
# (localhost excepted).
AUTH_SERVICE_URL=http://localhost:8000

# Outbound bearer for loging_service → auth_service /introspect. REQUIRED in
# production; must be distinct from every value in SERVICE_API_KEYS
# (key separation).
INTROSPECT_SERVICE_API_KEY=

# Emit Strict-Transport-Security header. Only enable behind https.
SECURITY_HSTS_ENABLED=false

# Human admin credentials for /docs login (POST /token)
# Swagger UI: click Authorize → enter username + password
LOGGING_ADMIN_USERNAME=admin
LOGGING_ADMIN_PASSWORD=change-me-immediately
