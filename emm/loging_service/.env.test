# Environment for running tests locally.
# The test database must exist and be accessible.
# Create it once:
#   docker exec -it logging_postgres psql -U logging_user -d logging_db -c "CREATE DATABASE logging_test;"
#
# Run tests:
#   cd loging_service
#   TEST_DATABASE_URL=postgresql+psycopg://logging_user:logging_password@localhost:5433/logging_test \
#   PYTHONPATH=. pytest
#
# conftest.py выставляет SERVICE_API_KEYS / INTROSPECT_SERVICE_API_KEY
# самостоятельно — здесь только URL базы.

TEST_DATABASE_URL=postgresql+psycopg://logging_user:logging_password@localhost:5433/logging_test
