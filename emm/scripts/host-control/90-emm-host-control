# sudoers snippet for the dedicated "emm-host-control" account used by
# server_service to start/stop/restart allta systemd units on its own host.
# Install as /etc/sudoers.d/90-emm-host-control (mode 0440, owned by root).
#
# One explicit line per unit x action, NO wildcards — a wildcard rule like
# "systemctl * *.service" would let anything reachable via this account run
# any systemctl subcommand on any unit, defeating the allowlist entirely.
# Add a new unit here (and to ALLOWED_UNITS in emm-host-service-guard.sh,
# and to ALLTA_HOST_UNITS in server_service) only after deciding it's safe
# for emm to control it — see README.md in this directory.

emm-host-control ALL=(root) NOPASSWD: /bin/systemctl start acs.service
emm-host-control ALL=(root) NOPASSWD: /bin/systemctl stop acs.service
emm-host-control ALL=(root) NOPASSWD: /bin/systemctl restart acs.service
