# ── Application ───────────────────────────────────────────────────────────────

# Deployment environment label: local | dev | test | staging | production
# В 'production' включается строгий validator: REDIS_URL должен содержать password.
APP_ENV=local

# Python logging level: DEBUG | INFO | WARNING | ERROR
WORKER_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL async DSN для собственной БД воркера (история тасков).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://app_user:app_password@postgres:5432/dev_server_worker

# ── Redis (taskiq broker) ─────────────────────────────────────────────────────

# REDIS_PASSWORD используется compose'ом для запуска `redis-server --requirepass`.
# В проде значение задаётся через Kubernetes Secret и обязано быть длинным
# случайным. Default годится ТОЛЬКО для локального dev-стека.
REDIS_PASSWORD=dev-redis-password

# Полный URL брокера. ОБЯЗАТЕЛЬНО с password в любом окружении кроме local-dev:
# без AUTH'а соседний pod может `RPUSH` payload в taskiq queue и инициировать
# power-cycle / password-rotation от имени воркера.
# Format: redis://:<password>@<host>:<port>/<db>
REDIS_URL=redis://:dev-redis-password@redis:6379/0

# ── External services ─────────────────────────────────────────────────────────

SERVER_SERVICE_URL=http://server_service:8002
AUTH_SERVICE_URL=http://auth_service:8000
LOGGING_SERVICE_URL=http://loging_service:8001

# Bearer (PAT/bot-token) для server_worker → server_service. Если пусто и в
# /shared смонтирован файл `.worker_pat` (его кладёт `make seed`), entrypoint
# контейнера сам подхватит токен оттуда.
WORKER_BOT_TOKEN=

# Shared SERVICE_API_KEY для loging_service `/events` ingest.
LOGGING_SERVICE_API_KEY=change-me-use-a-long-random-string

# HTTP timeout для исходящих вызовов (server_service, auth_service, logging).
HTTP_REQUEST_TIMEOUT_SECONDS=5.0

# Сколько одновременных SSH-коннектов worker открывает к одному (host, port).
# Backpressure против sshd MaxStartups при burst задач на один сервер; к разным
# хостам сессии параллельны. Дефолт 4 (ниже sshd-дефолта 10:30:100).
SSH_MAX_SESSIONS_PER_HOST=4

# ── Redfish / BMC client ──────────────────────────────────────────────────────

# Slot пользователя на iDRAC, к которому относятся `ipmi.rotate_password`
# операции. Dell out-of-box root = 2, HPE iLO root = 1, Supermicro = 3.
# Override per-host через payload `user_id`, env-default — fallback.
IPMI_USER_ID=2

# Проверять TLS-сертификат BMC. False — стандарт для iDRAC out-of-box
# (self-signed). True — только в стенде с BMC от внутреннего CA.
REDFISH_VERIFY_TLS=false

# Per-request HTTP timeout для Redfish-вызовов (connect + read).
# ResetActions ≤2s; для медленных BMC ставь больше. Worker retry/back-off
# compensate'ит transient failures.
REDFISH_TIMEOUT_SECONDS=30.0

# ── Retention / bounded growth ────────────────────────────────────────────────

# Сколько дней держать SUCCEEDED/FAILED task'и в `tasks` перед daily cleanup'ом
# (`tasks.cleanup_completed_old` в 03:00 MSK). QUEUED/RUNNING никогда не
# удаляются — их разгребает orphan-sweep. Уменьшай в dev/test при быстром
# росте таблицы; в prod compliance-чувствительных стендах audit-trail всё
# равно живёт в loging_service, тут только operational history.
TASKS_RETENTION_DAYS=30

# Сколько дней держать published outbox-row'ы (delivered + DLQ-poisoned) перед
# daily cleanup'ом (`audit_outbox.cleanup_published_old` в 03:30 MSK).
# Unpublished (in-flight) row'ы cleanup'ом не трогаются. Заметно больше
# `TASKS_RETENTION_DAYS` — outbox это immediate-forensics surface.
AUDIT_OUTBOX_RETENTION_DAYS=90

