# ── Application ───────────────────────────────────────────────────────────────

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8004

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+psycopg://testing_user:testing_password@localhost:5436/testing_db

# ── Redis (best-effort /ready ping + опциональный rate-limit backend) ────────

# Отдельный db-index на общем redis-контейнере: /0 — server_worker broker,
# /1 — auth_service rate-limit (prod), /2 — secret_service rate-limit,
# /3 — testing_service/testing_worker. testing_worker (../testing_worker)
# держит свой TASKIQ_QUEUE_NAME/broker — здесь Redis нужен только для
# /ready-пинга и опционального RATE_LIMIT_STORAGE_URI=redis://...
REDIS_URL=redis://localhost:6379/3

# ── Auth service (introspect для входящих токенов) ───────────────────────────

AUTH_SERVICE_URL=http://localhost:8000
INTROSPECT_SERVICE_API_KEY=change-me-introspect-key
INTROSPECT_TLS_VERIFY=true
INTROSPECT_TLS_CA_BUNDLE=

# ── Logging service (опциональный удалённый аудит) ───────────────────────────
# Пусто = удалённый аудит выключен: события остаются в логе процесса, в
# `audit_outbox` не пишутся, фоновый дренаж не поднимается.

LOGGING_SERVICE_URL=
LOGGING_SERVICE_API_KEY=

# Durable-доставка audit-событий (таблица `audit_outbox` + фоновый цикл,
# см. services/audit_outbox_publisher.py и AUDIT_EVENTS.md).

AUDIT_OUTBOX_POLL_INTERVAL_SECONDS=2.0
AUDIT_OUTBOX_BATCH_SIZE=20
AUDIT_OUTBOX_MAX_PUBLISH_ATTEMPTS=50
AUDIT_OUTBOX_RETENTION_HOURS=24

# ── Server service ───────────────────────────────────────────────────────────
# Сейчас используется резолверами choices_source (каталог OS-версий и ядер);
# дальше — prepare-for-test, acquire/release-for-service, test-credentials.
# Каталожные пути server_service гейтятся introspect'ом, поэтому в ключ кладётся
# токен, валидный для auth_service (бот-токен testing_service либо PAT), а не
# запись из SERVICE_API_KEYS.

SERVER_SERVICE_URL=http://localhost:8002
SERVER_SERVICE_API_KEY=
SERVER_REQUEST_TIMEOUT_SECONDS=5.0

# ── Inbound service-to-service auth ──────────────────────────────────────────

# Legacy fallback (deprecated, оставлен для миграции). Per-service map ниже —
# предпочтительный путь.
SERVICE_API_KEY=

# Per-service inbound map: каждый известный caller получает свой ключ.
# Формат: JSON-объект {"<service_name>": "<api_key>", ...} или
# comma-separated "<svc>:<key>,<svc>:<key>".
SERVICE_API_KEYS=

# ── Rate-limit ────────────────────────────────────────────────────────────────

SLOWAPI_RATE_LIMIT=120/second
RATE_LIMIT_STORAGE_URI=memory://
REDIS_PASSWORD=

WORKER_LOG_LEVEL=INFO

# Обнаружение ядер читает несколько индексов пакетов; отдельный таймаут от быстрых запросов каталога.
OS_KERNEL_DISCOVERY_TIMEOUT_SECONDS=120
