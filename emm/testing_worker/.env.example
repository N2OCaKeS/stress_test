# ── Application ───────────────────────────────────────────────────────────────

# Deployment environment label: local | dev | test | staging | production
APP_ENV=local

# Python logging level: DEBUG | INFO | WARNING | ERROR
WORKER_LOG_LEVEL=INFO

# ── Redis (taskiq broker) ─────────────────────────────────────────────────────

# Отдельный db-index на общем redis-контейнере: /0 — server_worker broker,
# /1 — auth_service rate-limit (prod), /2 — secret_service rate-limit,
# /3 — testing_service/testing_worker.
REDIS_URL=redis://:dev-redis-password@redis:6379/3

# Имя очереди taskiq (Redis-список), которую слушает testing_worker.
TASKIQ_QUEUE_NAME=testing_taskiq

# ── testing_service (очередь заданий) ────────────────────────────────────────

# Базовый URL testing_service — канал /internal/queue/claim и /completed.
TESTING_SERVICE_URL=http://testing_service:8004

# Shared-secret для /internal/queue/*. Должен совпадать с
# SERVICE_API_KEYS['testing_worker'] на стороне testing_service.
TESTING_SERVICE_INTERNAL_API_KEY=

# Пауза между вызовами claim, когда очередь пуста или testing_service
# недоступен. Если claim только что вернул задание — следующий вызов идёт
# сразу, без сна.
QUEUE_POLL_INTERVAL_SECONDS=3.0

# Сколько слотов run_polling_loop крутится КОНКУРЕНТНО в одном процессе (не
# отдельными процессами/подами) — не меньше числа стендов, которые реально
# могут одновременно готовиться/выполнять тест.
QUEUE_CONCURRENCY=4

# Как часто спрашивать /internal/queue/{id}/interrupt-check, пока тест
# выполняется. Задержка останова по кнопке «Пропустить»/«Остановить» — до
# этого интервала.
INTERRUPT_POLL_INTERVAL_SECONDS=7.0

# ── SSH-исполнение теста ──────────────────────────────────────────────────────

# Таймаут на TCP-коннект + SSH-handshake + аутентификацию до стенда.
SSH_CONNECT_TIMEOUT_SECONDS=30.0

# Грубый общий cap на исполнение команды теста по SSH — временная защита от
# зависшего процесса на стенде, не продуманный per-test timeout.
SSH_COMMAND_TIMEOUT_SECONDS=3600.0
