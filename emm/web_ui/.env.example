# Base URL for API requests. In dev the value `/api` plus the Vite dev-server
# proxy (see vite.config.ts) routes `/api/auth/*` to the local auth_service.
# In prod set it to the ingress prefix (typically still `/api` behind the same
# ingress as the SPA).
VITE_API_BASE_URL=/api

# When true, AuthContext skips the real auth_service and serves the mock
# personas from `src/mocks/personas.ts`. Useful for UI work without a backend.
# Default: false (real auth_service flow).
VITE_USE_MOCK_AUTH=false

# Only used by `vite dev`. Override the proxy target if auth_service runs on
# a different host/port than localhost:8000.
# VITE_AUTH_PROXY_TARGET=http://localhost:8000
