# devpi server
DEVPI_DATA_DIR=/home/partimag/devpi
DEVPI_PORT=3141
DEVPI_ROOT_PASSWORD=changeme_root
DEVPI_USER=user
DEVPI_PASSWORD=changeme_user
# indexes (создаётся при старте)
DEVPI_RELEASE_INDEX=release
DEVPI_DEV_INDEX=dev
DEVPI_INDEX_BASES=root/pypi
# new_release.py: git-токен через config_api
ALLTA_CONFIG_API_URL=https://allta.devos.astralinux.ru:21500
ALLTA_API_TOKEN=PASTE_BEARER_JWT_HERE
DEVPI_GIT_TOKEN_NAME=git_token
ALLTA_API_VERIFY_TLS=0
DEVPI_BASE_VERSION=0.0.1
# Сборка и заливка доков (sphinx) при upload. 1 = собирать доки пакета.
# Тема furo (см. Dockerfile), conf.py пакета переведён на furo.
DEVPI_UPLOAD_DOCS=1
# upload target внутри контейнера
DEVPI_INDEX_URL=http://localhost:3141/root/release
