# devpi server
DEVPI_DATA_DIR=/home/partimag/devpi
DEVPI_PORT=3141
DEVPI_ROOT_PASSWORD=changeme_root
# root/pypi создаётся как локальный stage, не как внешний mirror PyPI.
DEVPI_DISABLE_ROOT_PYPI=1
# Только root может создавать/изменять пользователей и индексы; upload регулируется acl_upload.
DEVPI_RESTRICT_MODIFY=root
# Локальный пользователь для наполнения root/pypi и автоматической загрузки allta.
DEVPI_LOCAL_UPLOAD_USER=allta
DEVPI_LOCAL_UPLOAD_PASSWORD=changeme_allta
# Пользователи создаются автоматически после успешной авторизации через Allta Auth API.
DEVPI_AUTOCREATE_USERS=1
DEVPI_AUTH_API_URL=https://allta.devos.astralinux.ru:21500
# API сейчас развернуто с проблемным сертификатом, поэтому TLS verification выключен.
DEVPI_AUTH_API_VERIFY_TLS=0
DEVPI_AUTH_API_AUTHORIZE_PATH=/api/auth/v1/integrations/devpi/authorize
# Группа devpi_upload выдаётся плагином только пользователям с devpi_write=true.
DEVPI_ACL_UPLOAD=root,allta,:devpi_upload
# indexes (создаются/настраиваются при старте)
DEVPI_PYPI_INDEX=pypi
DEVPI_RELEASE_INDEX=release
DEVPI_TEST_INDEX=test
# root/pypi наполняется только вручную/скриптами из заранее скачанных PyPI-пакетов.
DEVPI_PYPI_INDEX_BASES=
DEVPI_PYPI_ACL_UPLOAD=allta
DEVPI_PYPI_VOLATILE=False
# root/release наследуется от локального root/pypi, root/test наследуется от root/release.
DEVPI_RELEASE_INDEX_BASES=root/pypi
DEVPI_TEST_INDEX_BASES=root/release
DEVPI_DEV_INDEX=dev
DEVPI_RELEASE_VOLATILE=False
DEVPI_TEST_VOLATILE=True
# Индекс <user>/dev создаётся плагином при первом успешном входе пользователя.
DEVPI_AUTH_CREATE_USER_INDEX=1
DEVPI_AUTH_USER_INDEX=dev
DEVPI_AUTH_USER_INDEX_BASES=root/test
DEVPI_AUTH_USER_INDEX_VOLATILE=True
DEVPI_AUTH_USER_INDEX_ACL_UPLOAD={username}
# new_release.py: git-токен через config_api
ALLTA_CONFIG_API_URL=https://allta.devos.astralinux.ru:21500
ALLTA_API_TOKEN=PASTE_BEARER_JWT_HERE
DEVPI_GIT_TOKEN_NAME=git_token
ALLTA_API_VERIFY_TLS=0
DEVPI_BASE_VERSION=0.0.1
DEVPI_GIT_BRANCH=libs
DEVPI_CLONE_RETRY_INTERVAL=60
# Сборка и заливка доков (sphinx) при upload. 1 = собирать доки пакета.
# Тема furo (см. Dockerfile), conf.py пакета переведён на furo.
DEVPI_UPLOAD_DOCS=1
# upload target внутри контейнера
DEVPI_UPLOAD_USER=allta
DEVPI_UPLOAD_PASSWORD=changeme_allta
DEVPI_INDEX_URL=http://localhost:3141/root/release
DEVPI_TEST_INDEX_URL=http://localhost:3141/root/test
