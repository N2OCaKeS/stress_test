# syntax=docker/dockerfile:1.7
FROM portainer/portainer-ce:latest AS portainer

FROM alpine:3.20

ARG ALLTA_API_CA_B64

RUN apk add --no-cache ca-certificates curl jq tini
RUN test -n "$ALLTA_API_CA_B64" && \
    printf '%s' "$ALLTA_API_CA_B64" | base64 -d > /usr/local/share/ca-certificates/allta-api.crt && \
    update-ca-certificates

COPY --from=portainer /portainer /portainer
COPY --from=portainer /public /public
COPY --from=portainer /mustache-templates /mustache-templates
COPY --from=portainer /metadata.json /metadata.json
COPY --from=portainer /portainer.svg /portainer.svg
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
EXPOSE 9000
EXPOSE 9443

ENTRYPOINT ["/sbin/tini", "--", "/entrypoint.sh"]
