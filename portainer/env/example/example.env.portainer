# Portainer bootstrap + OAuth (allta_auth)
#
# WARNING: do not commit real passwords/secrets.
# This is a template. On `./install.sh precond` it will be copied to:
# - /var/allta_services/config/env.portainer
#
# Passwords:
# - Portainer requires admin password length >= 12 characters.
# - Use strong unique passwords.

# --- Base domain (needed inside container too) ---
# Docker container DNS may not know your internal domain; we map it via docker-compose extra_hosts.
ALLTA_DOMAIN=allta.devos.astralinux.ru
ALLTA_DOMAIN_IP=host-gateway

# --- Portainer bootstrap ---
PORTAINER_ADMIN_USERNAME=<ИМЯ ПОЛЬЗОВАТЕЛЯ>
PORTAINER_ADMIN_PASSWORD=<ПАРОЛЬ>

# Optional: create extra base user (role: 2=standard user, 1=admin)
PORTAINER_BASE_USERNAME=
PORTAINER_BASE_PASSWORD=
PORTAINER_BASE_ROLE=2

# --- RBAC bootstrap (recommended) ---
# Creates team and ensures all existing (Role==2) users are members.
# Resource controls for existing containers will be created/updated to grant the team access.
PORTAINER_RBAC_ENABLED=true
PORTAINER_RBAC_TEAM_NAME=portainer
PORTAINER_RBAC_SYNC_USERS=true
PORTAINER_RBAC_SYNC_CONTAINERS=true
PORTAINER_RBAC_ENDPOINT_NAME=local

# --- OAuth (Generic OAuth) ---
PORTAINER_OAUTH_ENABLED=true
PORTAINER_OAUTH_CLIENT_ID=allta-portainer
PORTAINER_OAUTH_CLIENT_SECRET=
PORTAINER_OAUTH_CLIENT_SECRET_FILE=/run/secrets/oauth_clients/allta-portainer.secret
PORTAINER_OAUTH_AUTHORIZATION_URL=http://allta.devos.astralinux.ru:21500/api/auth/v1/integrations/oauth/authorize
PORTAINER_OAUTH_ACCESS_TOKEN_URL=http://allta.devos.astralinux.ru:21500/api/auth/v1/integrations/oauth/token
PORTAINER_OAUTH_RESOURCE_URL=http://allta.devos.astralinux.ru:21500/api/auth/v1/integrations/oauth/userinfo
PORTAINER_OAUTH_REDIRECT_URL=https://allta.devos.astralinux.ru:9443/
PORTAINER_OAUTH_USER_IDENTIFIER=preferred_username
PORTAINER_OAUTH_SCOPES=profile

# Optional
PORTAINER_OAUTH_LOGOUT_URL=
PORTAINER_OAUTH_SSO=false
PORTAINER_OAUTH_AUTO_CREATE_USERS=true

# 0=auto-detect
PORTAINER_OAUTH_AUTH_STYLE=0
