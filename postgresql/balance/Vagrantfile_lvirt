Vagrant.configure("2") do |config|
  config.vm.box = ENV['UPDATE']
  config.vm.box_url = ENV['BOX_URL']
  config.vm.synced_folder "./", "/vagrant", disabled: true
  config.vm.boot_timeout = 180
    
  vms = [
    { :name => "database1", :hostname => "database1.balance.rbt", :args => "database1", :cpus => "4", :memory => "32768", :ip => "10.177.103.111" },
    { :name => "database2", :hostname => "database2.balance.rbt", :args => "database2", :cpus => "4", :memory => "32768", :ip => "10.177.103.112" },
    { :name => "database3", :hostname => "database3.balance.rbt", :args => "database3", :cpus => "8", :memory => "32768", :ip => "10.177.103.113" },
    { :name => "lbdb1", :hostname => "lbdb1.balance.rbt", :args => "lbdb1", :cpus => "8", :memory => "32768", :ip => "10.177.103.141" },
    { :name => "lbdb2", :hostname => "lbdb2.balance.rbt", :args => "lbdb2", :cpus => "8", :memory => "32768", :ip => "10.177.103.142" },
    { :name => "lbdb3", :hostname => "lbdb3.balance.rbt", :args => "lbdb3", :cpus => "8", :memory => "32768", :ip => "10.177.103.143" },
    { :name => "dcfreeipa", :hostname => "dcfreeipa.balance.rbt", :args => "dcfreeipa", :cpus => "8", :memory => "32768", :ip => "10.177.103.110" },
    { :name => "test", :hostname => "test.balance.rbt", :args => "test", :cpus => "2", :memory => "2048", :ip => "10.177.103.116" },
    { :name => "web1", :hostname => "web1.balance.rbt", :args => "web1", :cpus => "4", :memory => "4096", :ip => "10.177.103.117" },
    { :name => "web2", :hostname => "web2.balance.rbt", :args => "web2", :cpus => "4", :memory => "4096", :ip => "10.177.103.118" },
    { :name => "client", :hostname => "client.balance.rbt", :args => "client", :cpus => "2", :memory => "2048", :ip => "10.177.103.119" }
  ]

  vms.each do |vm|
    if ENV['VM_NAME'] == vm[:name] or ENV['VM_NAME'].nil?
      config.vm.define vm[:name] do |node|
        node.vm.hostname = vm[:hostname]
        node.vm.provider :libvirt do |v|
          v.memory = vm[:memory]
          v.cpus = vm[:cpus]
          v.default_prefix = ""
          v.disk_bus = "sata"
        end
    
        node.vm.provision "shell", path:"provision/env_provision_lvirt.sh", args: [vm[:args], ENV['KERNEL'], ENV['RC']]    
        node.vm.provision "shell", inline: "echo 'Rebooting VM...'; sudo reboot", run: "always"
      end
    end
  end
end