all:
  vars:
    astra_domain: balance.rbt
    debian_linux: false
    no_purge: true
    repo_pakages: true
    ansible_ssh_pass: vagrant
    ansible_ssh_user: vagrant
  children:

    servers:
      hosts:
        domain:
          ansible_host: ${dcfreeipa}
          domain_name: dcfreeipa

      children:
        web_servers:
          hosts:
            placeholder_host: 
              ansible_host: 127.0.0.1
              ansible_connection: local

        load_balancers_web:
          hosts:
            placeholder_host: 
              ansible_host: 127.0.0.1
              ansible_connection: local

        databases:
          hosts:
            database:
              ansible_host: ${database1}
              domain_name: database1

            database_2:
              ansible_host: ${database2}
              domain_name: database2

            database_3:
              ansible_host: ${database3}
              domain_name: database3

        load_balancers_db:
          vars:
            virtual_domain_name: pgpool
            delegate_ip: ${pgpool}
          hosts:
            lb_db:
              ansible_host: ${lbdb1}
              domain_name: lbdb1

            lb_db_2:
              ansible_host: ${lbdb2}
              domain_name: lbdb2

            lb_db_3:
              ansible_host: ${lbdb3}
              domain_name: lbdb3

    clients:
      hosts:
        placeholder_host: 
          ansible_host: 127.0.0.1
          ansible_connection: local
    development: