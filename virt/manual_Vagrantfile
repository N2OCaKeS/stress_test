Vagrant.configure("2") do |config|
    config.vm.box = ENV['UPDATE']
    config.vm.box_url = ENV['BOX_URL']
    config.vm.synced_folder "./", "/vagrant", disabled: true
    config.vm.boot_timeout = 180
    num_vms = ENV['COUNT'].to_i
    vms = []

    for i in 1..num_vms do
      new_vm = { 
        :name => "testvm#{i}", 
        :hostname => "testvm#{i}.stress.rbt", 
        :args => "testvm#{i}", 
        :cpus => ENV['CPU'], 
        :memory => ENV['RAM'],
      }
      vms.push(new_vm)
    end
      
    vms.each do |machine|
      config.vm.define machine[:name] do |node|
        node.vm.hostname = machine[:hostname]
        node.vm.provider :libvirt do |v|
          v.memory = machine[:memory]
          v.cpus = machine[:cpus]
          v.default_prefix = ""
          v.disk_bus = "sata"
        end
        
        node.vm.provision "shell", path:"provision/manual_provision.sh", args: [ENV['UPDATE']]
      end
    end
  end
